<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111A1E"
    android:fitsSystemWindows="true">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <xyz.wraithnet.phantom.ui.QrScanOverlay
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:gravity="center"
        android:text="Сканирование QR-кода"
        android:textColor="#EDF7F2"
        android:textSize="19sp"
        android:textStyle="bold"
        android:background="#E0111A1E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#E8111A1E"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Наведите камеру на QR-код"
            android:textColor="#C5D6D0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/phantom_qr_close"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#29463D"
            android:text="Закрыть"
            android:textAllCaps="false"
            android:textColor="#EDF7F2"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
